# Environment Configuration (development | staging | production)
NODE_ENV=development
PORT=3000

# Application
APP_NAME=ProcurementCoordinationPlatform
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/procurement_coord_dev

# Cache & Rate Limiting (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Use strong 256-bit random keys in staging/production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting & Throttling
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_THROTTLE_WINDOW_SECONDS=600
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Government Provider Configuration (MOCK | ESAMRIDHI)
GOVERNMENT_PROVIDER=MOCK
MOCK_GOV_LATENCY_MS=150

# e-Samridhi (NAFED / MoAFW) Production Pilot Integration Settings
ESAMRIDHI_API_BASE_URL=https://api.esamridhi.gov.in/v1
ESAMRIDHI_CLIENT_ID=
ESAMRIDHI_CLIENT_SECRET=
ESAMRIDHI_API_KEY=
ESAMRIDHI_TIMEOUT_MS=5000

