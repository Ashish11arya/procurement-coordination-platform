# ==============================================================================
# Staging / Pre-Production Environment Configuration (.env.staging)
# ==============================================================================
NODE_ENV=staging
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=https://staging.procurement.gov.in,https://staging-app.procurement.gov.in

# Managed Staging MongoDB Cluster
MONGODB_URI=mongodb+srv://staging_user:StagingPassword2026!@cluster0.staging.mongodb.net/procurement_coord_staging?retryWrites=true&w=majority

# Managed Staging Redis Cluster
REDIS_HOST=staging-redis.internal.gov.in
REDIS_PORT=6379
REDIS_PASSWORD=staging_secure_redis_auth_token_99341

# Cryptographic Keys (Supplied via Staging Secrets Vault)
JWT_ACCESS_SECRET=staging_super_secure_access_token_secret_key_883491_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=staging_super_secure_refresh_token_secret_key_883491_minimum
JWT_REFRESH_EXPIRES_IN=7d

# Throttling & Rate Limits
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_THROTTLE_WINDOW_SECONDS=600
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=150

# Staging Government Integration Provider
GOVERNMENT_PROVIDER=CFPP_SANDBOX
GOV_API_BASE_URL=https://sandbox.cfpp.gov.in/api/v2
GOV_API_CLIENT_ID=STAGING_AGY_COORD_01
GOV_API_CLIENT_SECRET=staging_gateway_secret_token_19283
SCHEDULER_MIN_NOTICE_MINUTES=45
