# ==============================================================================
# Development Environment Configuration (.env.development)
# ==============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Authoritative MongoDB Local Instance
MONGODB_URI=mongodb://localhost:27017/procurement_coord_dev

# Redis Local Instance
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cryptographic Keys (Development defaults)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# Throttling & Rate Limits
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_THROTTLE_WINDOW_SECONDS=600
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Mock Government Provider (Demo / Local Testing)
GOVERNMENT_PROVIDER=MOCK
MOCK_GOV_LATENCY_MS=100
SCHEDULER_MIN_NOTICE_MINUTES=45
