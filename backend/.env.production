# ==============================================================================
# Production Environment Configuration Template (.env.production)
# ALL SENSITIVE SECRETS MUST BE INJECTED AT RUNTIME VIA CLOUD SECRET MANAGER (NIC/GCP/AWS/AZURE)
# ==============================================================================
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=https://procurement.gov.in,https://app.procurement.gov.in

# Authoritative MongoDB Production Cluster (Replicated Replica Set)
MONGODB_URI=mongodb+srv://${PROD_DB_USER}:${PROD_DB_PASS}@cluster0.prod.gov.in/procurement_coord_prod?replicaSet=rs0&ssl=true&authSource=admin

# High-Availability Production Redis Cluster
REDIS_HOST=${PROD_REDIS_CLUSTER_ENDPOINT}
REDIS_PORT=6379
REDIS_PASSWORD=${PROD_REDIS_PASSWORD}

# Cryptographic Keys (Rotated via Hardware Security Module / Vault)
JWT_ACCESS_SECRET=${PROD_JWT_ACCESS_SECRET}
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=${PROD_JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRES_IN=7d

# Hardened Rate Limiting & Protection
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_THROTTLE_WINDOW_SECONDS=600
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Authoritative Government Production Gateways (Section 39)
# Configured post-accreditation with e-Samridhi / CFPP / State Portals
GOVERNMENT_PROVIDER=CFPP_PRODUCTION
GOV_API_BASE_URL=https://api.cfpp.gov.in/v1
GOV_API_CLIENT_ID=${PROD_GOV_CLIENT_ID}
GOV_API_CLIENT_SECRET=${PROD_GOV_CLIENT_SECRET}
GOV_MTLS_CERT_PATH=/etc/ssl/certs/gov_client_cert.pem
GOV_MTLS_KEY_PATH=/etc/ssl/certs/gov_client_key.pem
SCHEDULER_MIN_NOTICE_MINUTES=45
