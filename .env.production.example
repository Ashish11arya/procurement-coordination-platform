# ==============================================================================
# Production Environment Configuration Template (.env.production.example)
# Use this template to configure environment variables in your Cloud PaaS
# (Render / Railway / Fly.io) Secret Manager. NEVER commit real secrets to Git.
# ==============================================================================

# Core Application Environment
NODE_ENV=production
PORT=3000
APP_NAME=ProcurementCoordinationPlatform
API_PREFIX=api/v1

# Public URL / CORS Domains (Comma-separated list of allowed origins)
# Replace with your actual deployed URL (e.g. https://your-app.onrender.com)
CORS_ORIGIN=https://procurement-coordination-platform.onrender.com

# ------------------------------------------------------------------------------
# 1. Managed Database: MongoDB Atlas (Free Tier M0)
# Setup: https://cloud.mongodb.com -> Create M0 Cluster -> Database Access -> Network (0.0.0.0/0)
# Format: mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/<dbname>?retryWrites=true&w=majority
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://procure_user:REPLACE_WITH_STRONG_DB_PASSWORD@cluster0.abcde.mongodb.net/procurement_prod?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Managed Cache: Upstash Redis (Serverless Free Tier)
# Setup: https://console.upstash.com -> Create Database -> Details -> "ioredis" or "rediss://" URL
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
# Note: Use 'rediss://' (with double 's') to ensure TLS encryption over the public internet.
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:REPLACE_WITH_UPSTASH_PASSWORD@us1-tender-anteater-31234.upstash.io:6379

# ------------------------------------------------------------------------------
# 3. Cryptographic Security Secrets (JWT)
# Generate each using: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_KEY_RUN_OPENSSL_RAND_HEX_32
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_KEY_RUN_OPENSSL_RAND_HEX_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_KEY_RUN_OPENSSL_RAND_HEX_32
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. OTP & Rate Limiting Controls
# ------------------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_THROTTLE_WINDOW_SECONDS=600
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 5. Government Integration Provider
# Set to 'MOCK' for pilot/demo simulation, or 'ESAMRIDHI' for live national portal
# ------------------------------------------------------------------------------
GOVERNMENT_PROVIDER=MOCK
MOCK_GOV_LATENCY_MS=150

# Live e-Samridhi / AgriStack credentials (only needed when GOVERNMENT_PROVIDER=ESAMRIDHI)
ESAMRIDHI_API_BASE_URL=https://api.esamridhi.gov.in/v1
ESAMRIDHI_CLIENT_ID=
ESAMRIDHI_CLIENT_SECRET=
ESAMRIDHI_API_KEY=
ESAMRIDHI_TIMEOUT_MS=5000
